{
  "name": "telnyx-webdriverio-tests",
  "version": "1.0.0",
  "private": true,
  "description": "WebdriverIO end-to-end tests for Telnyx",
  "scripts": {
    "clean": "rimraf allure-results allure-report",
    "pretest": "npm run clean",
    "pretest:chrome": "npm run clean",
    "pretest:firefox": "npm run clean",
    "pretest:edge": "npm run clean",
    "test": "wdio run ./wdio.conf.ts",
    "test:chrome": "wdio run ./wdio.chrome.conf.ts",
    "test:firefox": "wdio run ./wdio.firefox.conf.ts",
    "test:edge": "wdio run ./wdio.edge.conf.ts",
    "test:single": "wdio run ./wdio.chrome.conf.ts --spec",
    "report:generate": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report",
    "report": "npm run report:generate && npm run report:open"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.13.6",
    "@wdio/allure-reporter": "^9.31.4",
    "@wdio/cli": "^9.31.9",
    "@wdio/local-runner": "^9.31.9",
    "@wdio/mocha-framework": "^9.31.9",
    "@wdio/spec-reporter": "^9.31.2",
    "@wdio/types": "^9.31.2",
    "allure-commandline": "^2.46.1",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "webdriverio": "^9.31.9"
  },
  "overrides": {
    "extract-zip": "2.0.1",
    "serialize-javascript": "6.0.2",
    "mocha": {
      "serialize-javascript": "6.0.2"
    },
    "@puppeteer/browsers": {
      "extract-zip": "2.0.1"
    }
  }
}