{
  "name": "telnyx-webdriverio-tests",
  "version": "1.0.0",
  "private": true,
  "description": "WebdriverIO end-to-end tests for Telnyx",
  "scripts": {
    "test": "wdio run ./wdio.conf.ts",
    "test:headed": "wdio run ./wdio.conf.ts --headed",
    "test:watch": "wdio run ./wdio.conf.ts --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.0",
    "@wdio/cli": "^9.31.9",
    "@wdio/local-runner": "^9.31.9",
    "@wdio/mocha-framework": "^9.31.9",
    "@wdio/spec-reporter": "^9.31.2",
    "@wdio/types": "^9.31.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "webdriverio": "^9.31.9"
  },
  "overrides": {
    "extract-zip": "2.0.1",
    "serialize-javascript": "6.0.2",
    "mocha": {
      "serialize-javascript": "6.0.2"
    },
    "@puppeteer/browsers": {
      "extract-zip": "2.0.1"
    }
  }
}