{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "@types/mocha",
      "webdriverio",
      "@wdio/globals/types",
      "@wdio/mocha-framework"
    ],
    "sourceMap": true
  },
  "include": [
    "wdio.*.ts",
    "test/**/*.ts"
  ]
}